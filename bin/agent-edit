#!/bin/bash
# agent-edit: external editor for coding agents (Claude Code, Codex, ...).
#
# Ctrl+G in a coding agent runs $VISUAL on its temp prompt file and reads the
# file back when the editor exits. agent-edit copies that file into a persistent drafts
# folder, opens the copy in the configured editor, waits until editing is
# done, then copies the result back. An editor that cannot open, or that
# fails, hands the same draft to the next editor (see "Fallback" below).
#
# Usage:
#   agent-edit <file>                  edit <file> (what the agent runs)
#   agent-edit --config                choose the editors interactively
#   agent-edit --config KEY=VALUE...   set editors, e.g. editor=textmate
#   agent-edit --show                  print the settings and the editor this
#                                   terminal would use
#
# Settings (the env var overrides the config file; the default depends on the OS):
#   editor         AGENT_EDIT_EDITOR         macOS: textmate (default) subl code
#                                                   macvim vim
#                                            Linux: gedit (default) subl code
#                                                   gvim vim
#   remote_editor  AGENT_EDIT_REMOTE_EDITOR  in VS Code server terminals
#                                            (code-server, Remote-SSH, WSL):
#                                            code (default, a tab in the owning
#                                            editor), vim
#
# Other env overrides:
#   AGENT_EDIT_CONFIG   config file    (default: ~/.config/agent-edit/config)
#   AGENT_EDIT_DIR      drafts folder  (default: ~/.agent-prompts)
#   AGENT_EDIT_PROFILE  VS Code profile for editor=code (default: scratch)
#   AGENT_EDIT_KEEP     draft retention in days (default: 730, i.e. 2 years;
#                    not a number: no pruning)
#
# Fallback: the configured editor is tried first, then the other editors of
# the platform in the order listed above, ending with vim in the terminal. An
# editor is passed over, with one line that says why, when it is not
# installed, when it is a GUI editor without a display (Linux) or in an SSH
# session (macOS), or when it exits with a non-zero status (a crash). Every
# editor opens the same draft, so text saved before a crash is kept. vim ends
# the chain: its exit status is final, and $EDITOR (or vi) is used only when
# vim is not installed. An unreachable VS Code server falls back to vim.
#
# Keep this script compatible with bash 3.2 (macOS /bin/bash).

set -u

conf="${AGENT_EDIT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-edit/config}"
dir="${AGENT_EDIT_DIR:-$HOME/.agent-prompts}"
profile="${AGENT_EDIT_PROFILE:-scratch}"
keep_days="${AGENT_EDIT_KEEP:-730}"
os="${AGENT_EDIT_OS:-$(uname -s)}"     # AGENT_EDIT_OS is for tests only

case "$os" in
    Darwin) local_editors="textmate subl code macvim vim" ;;
    *)      local_editors="gedit subl code gvim vim" ;;
esac
remote_editors="code vim"

# default_for KEY: print the default value of KEY on this platform.
default_for() {
    case "$1" in
        editor)        echo "${local_editors%% *}" ;;
        remote_editor) echo code ;;
    esac
}

warn() { echo "agent-edit: $*" >&2; }

usage() {
    echo "Usage: $(basename "$0") <file> | --config [KEY=VALUE...] | --show"
}

# in_list WORD "LIST": succeed if WORD is one of the space-separated LIST.
in_list() {
    case " $2 " in *" $1 "*) return 0 ;; esac
    return 1
}

# --- settings ---------------------------------------------------------------

# conf_get KEY: print the last value of KEY in the config file, if any.
conf_get() {
    [ -f "$conf" ] || return 0
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p" "$conf" | tail -n 1
}

# conf_set KEY VALUE: replace KEY in the config file.
conf_set() {
    local tmp="$conf.tmp.$$"
    mkdir -p "$(dirname "$conf")" || return 1
    {
        if [ -f "$conf" ]; then
            grep -v "^[[:space:]]*$1[[:space:]]*=" "$conf"
        else
            echo "# agent-edit settings; see $0 or run: agent-edit --config"
        fi
        echo "$1=$2"
    } > "$tmp" && mv "$tmp" "$conf"
}

# env_name KEY: print the env var that overrides KEY.
env_name() {
    case "$1" in
        editor)        echo AGENT_EDIT_EDITOR ;;
        remote_editor) echo AGENT_EDIT_REMOTE_EDITOR ;;
    esac
}

# setting KEY: print the effective value (env var, config file, default_for).
setting() {
    local var value
    var=$(env_name "$1")
    eval "value=\${$var:-}"
    [ -n "$value" ] || value=$(conf_get "$1")
    echo "${value:-$(default_for "$1")}"
}

# options KEY: print the valid values of KEY on this platform.
options() {
    case "$1" in
        editor)        echo "$local_editors" ;;
        remote_editor) echo "$remote_editors" ;;
    esac
}

# --- editors ----------------------------------------------------------------

# is_remote_cli PATH: succeed if PATH is a VS Code server CLI. A VS Code server
# (code-server, Remote-SSH, WSL) puts its bin/remote-cli first on its
# terminals' PATH; desktop VS Code terminals may set $VSCODE_IPC_HOOK_CLI too,
# so the CLI's path is what tells them apart.
is_remote_cli() {
    case "$1" in */remote-cli/*) return 0 ;; esac
    return 1
}

# find_remote_cli: print the server CLI of this terminal's VS Code server.
find_remote_cli() {
    local name path
    [ -S "${VSCODE_IPC_HOOK_CLI:-}" ] || return 1
    for name in code-server code; do
        path=$(command -v "$name" 2>/dev/null) || continue
        if is_remote_cli "$path"; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# find_code: print the desktop VS Code CLI. A drag-and-drop install on macOS
# (e.g. install_vscode in inc/install.sh) does not put `code` on PATH. A
# server CLI cannot open a local window, so it does not count.
find_code() {
    local path app="Visual Studio Code.app/Contents/Resources/app/bin/code"
    path=$(command -v code 2>/dev/null)
    if [ -n "$path" ] && ! is_remote_cli "$path"; then
        echo "$path"
        return 0
    fi
    [ "$os" = Darwin ] || return 1
    for path in "/Applications/$app" "$HOME/Applications/$app"; do
        if [ -x "$path" ]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# find_mate: print the TextMate CLI. TextMate installs mate only on request;
# the app bundle always contains one.
find_mate() {
    local path app
    for path in "$(command -v mate 2>/dev/null)" \
                /Applications/TextMate.app/Contents/MacOS/mate \
                "$HOME/Applications/TextMate.app/Contents/MacOS/mate" \
                /Applications/TextMate.app/Contents/Resources/mate \
                "$HOME/Applications/TextMate.app/Contents/Resources/mate"; do
        if [ -n "$path" ] && [ -x "$path" ]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# find_mvim: print the MacVim CLI. The DMG install does not put mvim on PATH;
# Homebrew links it into its bin.
find_mvim() {
    local path
    for path in "$(command -v mvim 2>/dev/null)" \
                /opt/homebrew/bin/mvim /usr/local/bin/mvim \
                /Applications/MacVim.app/Contents/bin/mvim \
                "$HOME/Applications/MacVim.app/Contents/bin/mvim"; do
        if [ -n "$path" ] && [ -x "$path" ]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# find_subl: print the Sublime Text CLI. The macOS app does not put subl on
# PATH.
find_subl() {
    local path
    for path in "$(command -v subl 2>/dev/null)" \
                "/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl" \
                "$HOME/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl"; do
        if [ -n "$path" ] && [ -x "$path" ]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# has_gui: succeed if a window opened from here reaches the user: on macOS,
# not an SSH session; elsewhere, an X11 or Wayland display.
has_gui() {
    case "$os" in
        Darwin) [ -z "${SSH_CONNECTION:-}${SSH_TTY:-}" ] ;;
        *)      [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] ;;
    esac
}

# can_show NAME: succeed if a window of editor NAME reaches the user. vim runs
# in the terminal; under WSL, code opens VS Code on Windows, which needs no
# display.
can_show() {
    case "$1" in
        vim)  return 0 ;;
        code) [ -z "${WSL_DISTRO_NAME:-}" ] || return 0 ;;
    esac
    has_gui
}

# installed NAME: succeed if editor NAME is installed.
installed() {
    case "$1" in
        code)     find_code >/dev/null ;;
        subl)     find_subl >/dev/null ;;
        textmate) [ "$os" = Darwin ] && find_mate >/dev/null ;;
        macvim)   find_mvim >/dev/null ;;
        gedit|gvim|vim) command -v "$1" >/dev/null 2>&1 ;;
        *)        return 1 ;;
    esac
}

# available NAME: succeed if editor NAME can run in this terminal.
available() {
    case "$1" in
        remote) find_remote_cli >/dev/null ;;
        *)      can_show "$1" && installed "$1" ;;
    esac
}

# why_not NAME: print why editor NAME is not available here.
why_not() {
    if ! can_show "$1"; then
        case "$os" in
            Darwin) echo "$1 cannot open a window in an SSH session" ;;
            *)      echo "$1 needs a display" ;;
        esac
    elif [ "$1" = textmate ]; then
        echo "textmate is not installed (run: dotenv patch to install TextMate)"
    else
        echo "$1 is not installed"
    fi
}

# chain_from NAME: print the editors to try, NAME first: NAME, then the other
# editors of this platform in their fixed order. vim ends the chain, so
# nothing follows it.
chain_from() {
    local name list="$1"
    if [ "$1" != vim ]; then
        for name in $local_editors; do
            [ "$name" = "$1" ] || list="$list $name"
        done
    fi
    echo "$list"
}

# next_editor [CAUSE]: set $choice to the next editor of $chain that can run
# here, or to "terminal" ($EDITOR) when none is left. CAUSE says why the
# previous editor failed. Each editor passed over gets one line with its
# cause; $reason keeps the first cause.
next_editor() {
    local cause="${1:-}" name
    while :; do
        name="${chain%% *}"
        case "$chain" in
            *" "*) chain="${chain#* }" ;;
            *)     chain="" ;;
        esac
        if [ -n "$cause" ]; then
            warn "$cause; trying ${name:-${EDITOR:-vi}}"
            [ -n "$reason" ] || reason="$cause"
        fi
        if [ -z "$name" ]; then
            choice=terminal
            return
        fi
        if available "$name"; then
            choice="$name"
            return
        fi
        cause=$(why_not "$name")
    done
}

# pick_editor: set $choice to the editor for this terminal: an editor name,
# "remote" (a tab in the VS Code server that owns it) or "terminal" ($EDITOR);
# $chain holds the editors to try after it and $reason the cause when $choice
# is not the configured editor.
pick_editor() {
    local want
    choice="" reason="" chain=""
    if available remote; then
        want=$(setting remote_editor)
        if ! in_list "$want" "$remote_editors"; then
            warn "unknown remote_editor '$want' (choose from: $remote_editors); using $(default_for remote_editor)"
            want=$(default_for remote_editor)
        fi
        if [ "$want" = code ]; then
            choice=remote
            chain=vim
            return
        fi
        chain=vim
    else
        want=$(setting editor)
        if ! in_list "$want" "$local_editors"; then
            warn "unknown editor '$want' (choose from: $local_editors); using $(default_for editor)"
            want=$(default_for editor)
        fi
        chain=$(chain_from "$want")
    fi
    next_editor
}

# run_in_terminal FILE COMMAND...: edit FILE with a terminal editor. A
# full-screen editor hides the fallback lines at once, so vim and nvim repeat
# the first cause on their message line once they have started.
run_in_terminal() {
    local file="$1"
    shift
    case "$reason:$(basename "$1")" in
        ?*:vim|?*:nvim)
            "$@" -c "autocmd VimEnter * echomsg 'agent-edit: $reason'" "$file" ;;
        *)
            "$@" "$file" ;;
    esac
}

# run_editor NAME FILE: open FILE in editor NAME and wait until editing is done.
run_editor() {
    case "$1" in
        remote)
            warn "opened in a VS Code tab; close the tab to return"
            "$(find_remote_cli)" --wait "$2"
            ;;
        code)
            warn "opened in VS Code; save, then close the tab to return"
            "$(find_code)" --new-window --wait --profile "$profile" "$2"
            ;;
        subl)
            # --wait blocks until the file's tab is closed.
            warn "opened in Sublime Text; save, then close the tab to return"
            "$(find_subl)" --new-window --wait "$2"
            ;;
        textmate)
            # -w waits until the document's window (tab) is closed.
            warn "opened in TextMate; save, then close the window to return"
            "$(find_mate)" -w "$2"
            ;;
        macvim)
            # -f keeps mvim in the foreground until the window is closed.
            warn "opened in MacVim; :wq to return"
            "$(find_mvim)" -f "$2"
            ;;
        gedit)
            # A standalone instance is its own process, so it blocks until
            # the window is closed, even when another gedit is already
            # running. Do not add --wait: gedit 41 segfaults on
            # --standalone --wait.
            warn "opened in gedit; save, then close the window to return"
            gedit --standalone "$2"
            ;;
        gvim)
            # -f keeps gvim in the foreground until the window is closed.
            warn "opened in gVim; :wq to return"
            gvim -f "$2"
            ;;
        vim)
            run_in_terminal "$2" vim
            ;;
        terminal)
            run_in_terminal "$2" "${EDITOR:-vi}"
            ;;
    esac
}

# why_failed NAME STATUS: print why editor NAME, which exited with STATUS,
# did not do its job.
why_failed() {
    case "$1" in
        # The server CLI exits non-zero only when it cannot reach the server,
        # e.g. a stale $VSCODE_IPC_HOOK_CLI after a window reload or in a
        # tmux session that outlived it.
        remote) echo "the VS Code server of this terminal is not reachable" ;;
        *)      echo "$1 exited with status $2" ;;
    esac
}

# --- commands ---------------------------------------------------------------

# describe KEY NAME: one-line description for the --config menu.
describe() {
    case "$1:$2" in
        editor:code)        echo "VS Code, new window with the '$profile' profile" ;;
        editor:textmate)    echo "TextMate" ;;
        editor:subl)        echo "Sublime Text" ;;
        editor:gvim)        echo "gVim (needs a display)" ;;
        editor:macvim)      echo "MacVim" ;;
        editor:gedit)       echo "gedit (needs a display)" ;;
        editor:vim)         echo "vim in the terminal" ;;
        remote_editor:code) echo "a tab in the code-server / VS Code window of this terminal" ;;
        remote_editor:vim)  echo "vim in the terminal" ;;
    esac
}

# choose KEY TITLE: interactive menu; print the chosen value. Enter keeps the
# saved value, or picks the default when none (or an invalid one) is saved.
choose() {
    local key="$1" current n i opt mark answer
    current=$(conf_get "$key")
    echo "$2" >&2
    if [ -n "$current" ] && ! in_list "$current" "$(options "$key")"; then
        echo "  (the saved $key '$current' is not valid here)" >&2
        current=""
    fi
    current="${current:-$(default_for "$key")}"
    n=0
    for opt in $(options "$key"); do
        n=$((n + 1))
        mark=""
        [ "$opt" = "$current" ] && mark=" (current)"
        if [ "$key" = editor ] && ! available "$opt"; then
            mark="$mark (not available here)"
        fi
        printf '  %d) %-9s %s%s\n' "$n" "$opt" "$(describe "$key" "$opt")" "$mark" >&2
    done
    while :; do
        read -r -p "Choose 1-$n (Enter keeps $current): " answer || return 1
        if [ -z "$answer" ]; then
            echo "$current"
            return 0
        fi
        i=0
        for opt in $(options "$key"); do
            i=$((i + 1))
            if [ "$answer" = "$i" ] || [ "$answer" = "$opt" ]; then
                echo "$opt"
                return 0
            fi
        done
        echo "  invalid choice: $answer" >&2
    done
}

show() {
    local key var value
    echo "config file: $conf"
    for key in editor remote_editor; do
        var=$(env_name "$key")
        value=$(setting "$key")
        printf '%s=%s  (options: %s)' "$key" "$value" "$(options "$key")"
        eval "[ -n \"\${$var:-}\" ]" && printf '  [from %s]' "$var"
        in_list "$value" "$(options "$key")" || printf '  [invalid; %s is used]' "$(default_for "$key")"
        echo
    done
    value=$(setting editor)
    in_list "$value" "$local_editors" || value=$(default_for editor)
    echo "editor tries in order: $(chain_from "$value")"
    pick_editor 2>/dev/null
    case "$choice" in
        remote)   value="a tab in the VS Code server that owns it" ;;
        terminal) value="${EDITOR:-vi}" ;;
        *)        value="$choice" ;;
    esac
    echo "this terminal uses: $value${reason:+ (fallback: $reason)}"
}

# configure [KEY=VALUE...]: validate every setting, then save them all.
configure() {
    local arg key value var
    if [ $# -eq 0 ]; then
        if [ ! -t 0 ]; then
            warn "--config without KEY=VALUE needs a terminal"
            return 2
        fi
        value=$(choose editor "Ctrl+G editor for coding agents ($os):") || return 1
        set -- "editor=$value"
        value=$(choose remote_editor \
            "Editor inside VS Code server terminals (code-server, Remote-SSH, WSL):") || return 1
        set -- "$@" "remote_editor=$value"
    fi
    for arg in "$@"; do
        key="${arg%%=*}"
        value="${arg#*=}"
        if [ "$key" = "$arg" ] || ! in_list "$key" "editor remote_editor"; then
            warn "expected editor=NAME or remote_editor=NAME, got '$arg'; nothing saved"
            return 2
        fi
        if ! in_list "$value" "$(options "$key")"; then
            warn "invalid $key '$value' (choose from: $(options "$key")); nothing saved"
            return 2
        fi
    done
    for arg in "$@"; do
        key="${arg%%=*}"
        conf_set "$key" "${arg#*=}" || return 1
        var=$(env_name "$key")
        eval "[ -n \"\${$var:-}\" ]" && warn "note: $var is set and overrides $key in $conf"
    done
    echo "Saved to $conf"
    show
}

# migrate_drafts: with the default drafts folder, move the old default
# (~/.claude-prompts) to the new one the first time.
migrate_drafts() {
    [ -z "${AGENT_EDIT_DIR:-}" ] || return 0
    [ ! -e "$dir" ] && [ -d "$HOME/.claude-prompts" ] || return 0
    if mv "$HOME/.claude-prompts" "$dir"; then
        warn "moved $HOME/.claude-prompts to $dir"
    else
        warn "could not move $HOME/.claude-prompts to $dir; using $dir"
    fi
}

edit() {
    local src="$1" dst status prune=1
    case "$keep_days" in
        ''|*[!0-9]*)
            warn "AGENT_EDIT_KEEP='$keep_days' is not a number of days; not pruning drafts"
            prune=""
            ;;
    esac
    pick_editor

    migrate_drafts
    mkdir -p "$dir" || return 1
    dst="$dir/$(date +%Y%m%d-%H%M%S)-$$.md"

    cp "$src" "$dst" || return 1
    # An editor that fails hands the same draft to the next one, so whatever
    # it saved is kept. vim and $EDITOR end the chain: their status is final
    # (e.g. :cq to abort), and then the prompt is left as it was.
    while :; do
        run_editor "$choice" "$dst"
        status=$?
        [ "$status" -ne 0 ] || break
        case "$choice" in vim|terminal) return "$status" ;; esac
        next_editor "$(why_failed "$choice" "$status")"
    done
    cp "$dst" "$src" || return 1

    # Prune drafts not modified for more than $keep_days days.
    [ -z "$prune" ] || find "$dir" -name '*.md' -mtime +"$keep_days" -delete 2>/dev/null
    return 0
}

case "${1:-}" in
    --config)  shift; configure "$@" ;;
    --show)    show ;;
    -h|--help) usage ;;
    "")        usage >&2; exit 2 ;;
    -*)        warn "unknown option: $1"; usage >&2; exit 2 ;;
    *)         edit "$1" ;;
esac
